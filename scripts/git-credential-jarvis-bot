#!/usr/bin/env bash
# git credential helper pinned to jarvis-agent-bot328 (installed per clone by scripts/pin_git_identity.sh).
# Asks gh for the bot's token by name, so it holds even after Cursor logs `gh` back in as its
# `cursor` app. Falls back to GH_TOKEN (Mac: loaded from Keychain) and, on a Cloud Agent VM,
# to Secret Manager `github-bot-pat`. Prints nothing when no bot token is reachable.
set -uo pipefail

[ "${1:-}" = get ] || exit 0
cat >/dev/null

BOT=jarvis-agent-bot328
here="$(cd "$(dirname "$0")" && pwd)"
token="$(env -u GH_TOKEN gh auth token --hostname github.com --user "$BOT" 2>/dev/null)" || token=""
[ -n "$token" ] || token="${GH_TOKEN:-}"
if [ -z "$token" ] && [ "$(uname -s)" != Darwin ]; then
  token="$(python3 "$here/cloud_agent_gcp.py" secret github-bot-pat 2>/dev/null)" || token=""
fi
[ -n "$token" ] || exit 0
printf 'username=%s\npassword=%s\n' "$BOT" "$token"
